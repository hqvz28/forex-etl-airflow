# Airflow Base Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.5.1
AIRFLOW_UID=50000

# APILayer Exchange Rates API Configuration
# Sign up at: https://apilayer.com/marketplace/exchangerates_data-api
AIRFLOW_VAR_API_KEY=your_apilayer_api_key_here
EXCHANGE_RATES_API_KEY=your_apilayer_api_key_here

# Telegram Notification Bot Configuration
# Create bot via @BotFather on Telegram
AIRFLOW_VAR_BOT_TOKEN=your_telegram_bot_token_here
AIRFLOW_VAR_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
